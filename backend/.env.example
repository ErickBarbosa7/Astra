# Server
PORT=4000
NODE_ENV=development

# Base de datos (PostgreSQL via Docker Compose, puerto 5433)
DATABASE_URL="postgresql://astra:astra_dev_password@localhost:5433/astra?schema=public"

# CORS
CORS_ORIGIN=http://localhost:5176

# Autenticación (JWT access + refresh token opaco en cookie HTTP-only)
# Generar con: openssl rand -hex 32
JWT_ACCESS_SECRET=dev_access_secret_change_me_0123456789abcdef
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
